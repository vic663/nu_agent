#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --output={{ case_dir }}/slurm-%j.out
#SBATCH --error={{ case_dir }}/slurm-%j.out
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks={{ n_tasks }}
#SBATCH --cpus-per-task=1
#SBATCH --time={{ walltime }}
{% if partition %}#SBATCH --partition={{ partition }}{% endif %}
{% if account %}#SBATCH --account={{ account }}{% endif %}
{% for line in extra_directives %}#SBATCH {{ line }}
{% endfor %}
# Generated by NuAgent {{ nuagent_version }}
set -o pipefail
{% for m in modules %}module load {{ m }}
{% endfor %}
{% if foam_bashrc %}export NUAGENT_FOAM_BASHRC="{{ foam_bashrc }}"{% endif %}
{% if festim_python %}export NUAGENT_FESTIM_PYTHON="{{ festim_python }}"{% endif %}
export OMP_NUM_THREADS=1
cd "{{ case_dir }}" || exit 1
echo "[nuagent] SLURM job $SLURM_JOB_ID on $(hostname) with $SLURM_NTASKS tasks"
bash ./Allrun {{ run_args }}
rc=$?
echo "[nuagent] Allrun exit code: $rc"
echo "$rc" > "{{ case_dir }}/.nuagent_exit_code"
exit $rc
