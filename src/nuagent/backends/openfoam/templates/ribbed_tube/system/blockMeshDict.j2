/*--------------------------------*- C++ -*----------------------------------*\
| Generated by NuAgent {{ nuagent_version }} — rib-roughened tube (axisymmetric wedge)  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Tube D = {{ diameter }} m with {{ n_ribs }} transverse square ribs: e/D = {{ e_over_D }}, p/e = {{ p_over_e }}, w/e = {{ w_over_e }}
// Smooth entry {{ inlet_length }} m, ribbed section {{ ribbed_length }} m, smooth exit {{ outlet_length }} m
// Blocks: a core block (axis -> rib tip radius) in every segment plus a rib-layer block
// (rib tip radius -> wall) in the smooth and gap segments; rib segments have no layer block,
// so the rib faces become wall boundaries.  {{ n_blocks }} blocks, {{ n_cells }} cells.
// Vertex numbering per axial station i (5 per station): A=5i axis, Bm=5i+1 / Bp=5i+2 rib-tip radius
// at -theta/+theta, Cm=5i+3 / Cp=5i+4 wall radius at -theta/+theta.

scale 1;

vertices
(
{% for st in station_vertices %}
    ({{ st.x }} 0 0)                                   // {{ 5 * loop.index0 }}  station {{ loop.index0 }} axis
    ({{ st.x }} {{ r1y }} {{ r1z_neg }})              // {{ 5 * loop.index0 + 1 }}  rib tip, -theta
    ({{ st.x }} {{ r1y }} {{ r1z_pos }})              // {{ 5 * loop.index0 + 2 }}  rib tip, +theta
    ({{ st.x }} {{ ry }} {{ rz_neg }})                // {{ 5 * loop.index0 + 3 }}  wall, -theta
    ({{ st.x }} {{ ry }} {{ rz_pos }})                // {{ 5 * loop.index0 + 4 }}  wall, +theta
{% endfor %}
);

blocks
(
{% for b in blocks %}
    // segment {{ b.segment }} ({{ b.kind }}), {{ b.layer }}
    hex ({{ b.v | join(" ") }}) ({{ b.nx }} {{ b.ny }} 1) simpleGrading ({{ b.gx }} {{ b.gy }} 1)
{% endfor %}
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
{% for f in inlet_faces %}
            ({{ f | join(" ") }})
{% endfor %}
        );
    }
    outlet
    {
        type patch;
        faces
        (
{% for f in outlet_faces %}
            ({{ f | join(" ") }})
{% endfor %}
        );
    }
    wall
    {
        type wall;
        faces
        (
{% for f in wall_faces %}
            ({{ f | join(" ") }})
{% endfor %}
        );
    }
    front
    {
        type wedge;
        faces
        (
{% for f in front_faces %}
            ({{ f | join(" ") }})
{% endfor %}
        );
    }
    back
    {
        type wedge;
        faces
        (
{% for f in back_faces %}
            ({{ f | join(" ") }})
{% endfor %}
        );
    }
    axis
    {
        type empty;
        faces
        (
{% for f in axis_faces %}
            ({{ f | join(" ") }})
{% endfor %}
        );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
