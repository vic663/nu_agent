#!/bin/bash
# Generated by NuAgent {{ nuagent_version }} — run script for case '{{ case_name }}'
# Usage: ./Allrun   (sources the OpenFOAM environment itself if WM_PROJECT_DIR is unset;
#                    set NUAGENT_FOAM_BASHRC to point at a specific etc/bashrc)
set -o pipefail
cd "$(dirname "$0")" || exit 1

if [ -z "${WM_PROJECT_DIR:-}" ]; then
    for rc in "${NUAGENT_FOAM_BASHRC:-}" \
              /usr/lib/openfoam/openfoam*/etc/bashrc /opt/openfoam*/etc/bashrc \
              /usr/share/openfoam/etc/bashrc /openfoam/bash.rc; do
        if [ -n "$rc" ] && [ -f "$rc" ]; then
            # shellcheck disable=SC1090
            source "$rc" >/dev/null 2>&1 && break
        fi
    done
fi
command -v blockMesh >/dev/null 2>&1 || { echo "[nuagent] OpenFOAM not found" >&2; exit 127; }
echo "[nuagent] OpenFOAM ${WM_PROJECT_VERSION:-?} at ${WM_PROJECT_DIR:-?}"

CONTINUE=0
[ "${1:-}" = "--continue" ] && CONTINUE=1   # restart the solver from the latest time; keep mesh and results

run() {  # run <log-name> <command...>
    local log="log.$1"; shift
    echo "[nuagent] $*"
    if [ $CONTINUE -eq 1 ] && [ -f "$log" ]; then
        { echo; echo "// ---- nuagent: continued run ----"; } >> "$log"
        "$@" >> "$log" 2>&1
    else
        "$@" > "$log" 2>&1
    fi
    local rc=$?
    if [ $rc -ne 0 ]; then echo "[nuagent] FAILED ($rc): see $log" >&2; exit $rc; fi
}

if [ $CONTINUE -eq 0 ]; then
    rm -rf processor* postProcessing log.* [1-9]* 0.[0-9]* 2>/dev/null
    run blockMesh blockMesh
    run checkMesh checkMesh -allGeometry -allTopology
else
    echo "[nuagent] continuing from the latest time directory"
fi
{% if n_procs > 1 %}
run decomposePar decomposePar -force
run {{ application }} mpirun --oversubscribe -np {{ n_procs }} {{ application }} -parallel
run reconstructPar reconstructPar -latestTime
{% else %}
run {{ application }} {{ application }}
{% endif %}

# Optional derived wall fields (non-fatal: some builds cannot run function objects)
for func in wallShearStress{% if turbulent %} yPlus{% endif %}; do
    if postProcess -func "$func" -latestTime > "log.postProcess.$func" 2>&1; then
        echo "[nuagent] postProcess -func $func: ok"
    else
        echo "[nuagent] postProcess -func $func: unavailable (non-fatal)"
    fi
done
echo "[nuagent] done"
