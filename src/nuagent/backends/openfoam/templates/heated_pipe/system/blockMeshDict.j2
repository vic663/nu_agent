| Generated by NuAgent {{ nuagent_version }} — axisymmetric heated pipe (wedge)   |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pipe axis along +x; radial direction +y; the wedge spans -theta..+theta in z.
// D = {{ diameter }} m, L = {{ length }} m, half-angle = {{ wedge_angle_deg }} deg
// Nx = {{ n_axial }}, Nr = {{ n_radial }}, radial grading (wall cell / axis cell) = {{ radial_grading }}
// Topology follows the OpenFOAM 'movingCone' wedge tutorial (collapsed axis, empty patch).

scale 1;

vertices
(
    (0            0        0)                    // 0  axis, inlet
    ({{ length }} 0        0)                    // 1  axis, outlet
    (0            {{ ry }} {{ rz_neg }})         // 2  wall, inlet,  -theta
    ({{ length }} {{ ry }} {{ rz_neg }})         // 3  wall, outlet, -theta
    (0            {{ ry }} {{ rz_pos }})         // 4  wall, inlet,  +theta
    ({{ length }} {{ ry }} {{ rz_pos }})         // 5  wall, outlet, +theta
);

blocks
(
    hex (0 1 3 2 0 1 5 4) ({{ n_axial }} {{ n_radial }} 1)
    simpleGrading (1 {{ radial_grading }} 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 0 4 2));
    }
    outlet
    {
        type patch;
        faces ((1 3 5 1));
    }
    wall
    {
        type wall;
        faces ((2 4 5 3));
    }
    front
    {
        type wedge;
        faces ((0 2 3 1));
    }
    back
    {
        type wedge;
        faces ((0 1 5 4));
    }
    axis
    {
        type empty;
        faces ((0 1 1 0));
    }
);

mergePatchPairs
(
);

