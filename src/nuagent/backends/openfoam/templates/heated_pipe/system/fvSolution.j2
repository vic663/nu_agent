/*--------------------------------*- C++ -*----------------------------------*\
| Generated by NuAgent {{ nuagent_version }}                                      |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|h|k|omega|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.05;
    }
}

SIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors {{ n_non_orthogonal_correctors }};
    pRefCell        0;
    pRefValue       0;
    consistent      no;

    residualControl
    {
        p_rgh           {{ residual_target }};
        U               {{ residual_target }};
        h               {{ residual_target }};
        "(k|omega|epsilon)" {{ residual_target_turb }};
    }
}

relaxationFactors
{
    fields
    {
        rho             1.0;
        p_rgh           {{ relax_p }};
    }
    equations
    {
        U               {{ relax_U }};
        h               {{ relax_h }};
        "(k|omega|epsilon)" {{ relax_turbulence }};
    }
}

// ************************************************************************* //
